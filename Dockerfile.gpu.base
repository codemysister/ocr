# Runtime GPU: apt + pip Paddle + dataset. Jarang di-build (REBUILD_BASE=1).
# ARG PADDLE_GPU_INDEX: cu126 (RTX 20/30/40) | cu129 (RTX 50)

FROM python:3.12-slim-bookworm

ARG PADDLE_GPU_INDEX=cu126

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        libgomp1 \
        libglib2.0-0 \
        libgl1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-mistral.txt ./
# Jangan pasang paddlepaddle CPU dulu — sisa libpaddle.so membuat import GPU gagal.
RUN grep -vE '^paddlepaddle' requirements.txt > /tmp/requirements-no-paddle.txt \
    && pip install --upgrade pip setuptools wheel \
    && pip install -r /tmp/requirements-no-paddle.txt -r requirements-mistral.txt \
    && python -m pip install paddlepaddle-gpu==3.2.0 \
         -i "https://www.paddlepaddle.org.cn/packages/stable/${PADDLE_GPU_INDEX}/"

COPY dataset ./dataset
COPY scripts/verify_ocr_deps.py ./scripts/verify_ocr_deps.py

ENV OCR_VERIFY_ALLOW_NO_CUDA=1
RUN python scripts/verify_ocr_deps.py

ENV HOST=0.0.0.0 \
    PORT=8001 \
    OCR_DEVICE=gpu \
    OCR_FAST_LANG=latin \
    DATASET_ROOT=/app/dataset \
    OCR_FAST_DOC_UNWARPING=1 \
    PREPROCESS_AUTO_ROTATE_QUARTERS=auto \
    PREPROCESS_PROJECTION_DESKEW=1 \
    PREPROCESS_FULL_BLEED_STRAIGHTEN=1 \
    PREPROCESS_CARD_WARP=1 \
    PREPROCESS_MIN_SIDE_TARGET=900

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -sf "http://127.0.0.1:${PORT}/systems/ocr/health" | grep -q '"paddlepaddle_importable": true' || exit 1
