# Salin ke .env lalu isi key kamu (file .env tidak di-commit).
# Daftar API key: https://console.mistral.ai/

MISTRAL_API_KEY=k9PwAVmgEojUVMnzMoOYblWXmc04E3r2
MISTRAL_OCR_MODEL=mistral-ocr-2512

# Opsional
# MISTRAL_OCR_MODEL=mistral-ocr-2512
# MISTRAL_OCR_ANNOTATION=1
# MISTRAL_OCR_ANNOTATION_PROMPT=...
# MISTRAL_OCR_TABLE_FORMAT=markdown
# MISTRAL_OCR_INCLUDE_IMAGE_BASE64=0
# MISTRAL_USD_TO_IDR=17000

# --- LLM fallback validasi (lokal, OpenAI-compatible) ---
# Dipanggil otomatis bila validasi Paddle gagal — kirim gambar langsung ke AI multimodal.
LLM_FALLBACK_ENABLED=1
LLM_FALLBACK_BASE_URL=http://172.21.15.218:8080/v1
LLM_FALLBACK_MODEL=qwen
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_TIMEOUT_S=90
# LLM_FALLBACK_MAX_TOKENS=768
# LLM_FALLBACK_MIN_CONFIDENCE=60
# LLM_FALLBACK_LOG_PATH=logs/llm_fallback_errors.jsonl
# LLM_FALLBACK_LOG_MAX_ENTRIES=500

# --- OCR device (PaddleOCR) ---
# Default GPU. Di image Docker: fallback CPU jika CUDA tidak ada di container.
# OCR_DEVICE=gpu
# OCR_DEVICE_FALLBACK=1

# --- Docker Hub / server ---
# OCR_IMAGE=akunanda/ocr:latest

# --- CV search (subsistem terpisah) ---
# Jalankan OpenSearch: docker compose -f docker-compose.cv.yml up -d
# Install deps: pip install -r requirements-cv.txt

OPENSEARCH_URL=http://localhost:9200
CV_OPENSEARCH_INDEX=cv_chunks
CV_EMBED_MODEL=BAAI/bge-m3
CV_MAX_CHUNK_CHARS=1500
CV_SCAN_MIN_CHARS_PER_PAGE=80
CV_SEARCH_TOP_K=10
CV_EMBED_BATCH_SIZE=16
# Tier PP-OCRv6 untuk CV scan/gambar (balanced | medium | small | tiny); default small = lebih cepat
# CV_OCR_PP_TIER=small
# Matikan modul berat Paddle saat OCR CV (lebih cepat):
# OCR_FAST_DOC_ORIENTATION=0
# OCR_FAST_DOC_UNWARPING=0
# OCR_FAST_TEXTLINE_ORIENTATION=0
