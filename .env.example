# Salin ke .env lalu isi key kamu (file .env tidak di-commit).
# Daftar API key: https://console.mistral.ai/

MISTRAL_API_KEY=k9PwAVmgEojUVMnzMoOYblWXmc04E3r2
MISTRAL_OCR_MODEL=mistral-ocr-2512

# Opsional
# MISTRAL_OCR_MODEL=mistral-ocr-2512
# MISTRAL_OCR_ANNOTATION=1
# MISTRAL_OCR_ANNOTATION_PROMPT=...
# MISTRAL_OCR_TABLE_FORMAT=markdown
# MISTRAL_OCR_INCLUDE_IMAGE_BASE64=0
# MISTRAL_USD_TO_IDR=17000

# --- LLM fallback validasi (lokal, OpenAI-compatible) ---
# Dipanggil otomatis bila validasi Paddle gagal — kirim gambar langsung ke AI multimodal.
LLM_FALLBACK_ENABLED=1
LLM_FALLBACK_BASE_URL=http://172.21.15.218:8081/v1
LLM_FALLBACK_MODEL=/models/Ornith-1.5-9B-AD-Q5_K-Q4_K.gguf
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_TIMEOUT_S=90
# LLM_FALLBACK_MAX_TOKENS=768
# LLM_FALLBACK_MIN_CONFIDENCE=60
# --- Tes OCR AI surat kesehatan (Ornith multimodal, halaman /health-letter-ai) ---
LLM_HEALTH_AI_BASE_URL=http://172.21.13.26:8080/v1
# LLM_HEALTH_AI_MODEL=ornith-1.5-9b
# LLM_HEALTH_AI_TIMEOUT_S=120
# LLM_HEALTH_AI_MAX_TOKENS=1536
# Thinking Ornith memakan max_tokens lalu content kosong; default dimatikan.
# LLM_HEALTH_AI_ENABLE_THINKING=0
# LLM_HEALTH_AI_ALLOW_ANY_URL=0
# Vaksinasi booster memakai server Ornith yang sama (override opsional):
# LLM_VAKSINASI_3_AI_BASE_URL=http://172.21.13.26:8080/v1
# LLM_VAKSINASI_3_AI_MODEL=ornith-1.5-9b
# LLM_VAKSINASI_3_AI_MAX_TOKENS=512
# Vaksinasi dosis 2 memakai server Ornith yang sama (override opsional):
# LLM_VAKSINASI_2_AI_BASE_URL=http://172.21.13.26:8080/v1
# LLM_VAKSINASI_2_AI_MODEL=ornith-1.5-9b
# LLM_VAKSINASI_2_AI_MAX_TOKENS=512
# Vaksinasi dosis 1 memakai server Ornith yang sama (override opsional):
# LLM_VAKSINASI_1_AI_BASE_URL=http://172.21.13.26:8080/v1
# LLM_VAKSINASI_1_AI_MODEL=ornith-1.5-9b
# LLM_VAKSINASI_1_AI_MAX_TOKENS=512
# BPJS Kesehatan memakai server Ornith yang sama (override opsional):
# LLM_BPJS_AI_BASE_URL=http://172.21.13.26:8080/v1
# LLM_BPJS_AI_MODEL=ornith-1.5-9b
# LLM_BPJS_AI_MAX_TOKENS=512
# Rekening tabungan memakai server Ornith yang sama (override opsional):
# LLM_REKENING_AI_BASE_URL=http://172.21.13.26:8080/v1
# LLM_REKENING_AI_MODEL=ornith-1.5-9b
# LLM_REKENING_AI_MAX_TOKENS=512
# NPWP memakai server Ornith yang sama (override opsional):
# LLM_NPWP_AI_BASE_URL=http://172.21.13.26:8080/v1
# LLM_NPWP_AI_MODEL=ornith-1.5-9b
# LLM_NPWP_AI_MAX_TOKENS=512
# Pemadanan NPWP memakai server Ornith yang sama (override opsional):
